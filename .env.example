# Copy to .env and fill in.

# REQUIRED. SEC asks every client to identify itself with a name and contact email.
MI_SEC_USER_AGENT="market-intel you@example.com"

# Yahoo Finance kill switch. Set to false to stop ALL Yahoo traffic:
#  - analysts / estimates / corporate-actions return 503 dataset_unavailable
#  - profile / ownership / events / fundamentals fall back to SEC EDGAR data only
MI_YAHOO_ENABLED=true

# Comma-separated API keys (one per consuming app). Empty = auth disabled (local dev only).
MI_API_KEYS=

MI_CACHE_DIR=.cache/market-intel
# MI_SEC_MAX_RPS=8
# MI_YAHOO_MAX_RPS=2
